# Salin ke .env (di-ignore git) lalu isi. Backend mati di start kalau salah satu wajib hilang.
DATABASE_URL=host=localhost user=postgres dbname=portfolio_db port=5432 sslmode=disable TimeZone=Asia/Jakarta
JWT_SECRET=
ADMIN_USER=admin
ADMIN_PASS=
# Penerima suret form kontak. Kalau kosong, pesan tetap masuk DB tapi suret dilewati + dicatat di log.
ADMIN_EMAIL=
# Opsional: origin CORS, dipisah koma. Default http://localhost:3000 + domain produksi.
CORS_ORIGINS=
